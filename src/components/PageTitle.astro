---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';

const data = Astro.locals.starlightRoute.entry.data;
const needsDiscussionArticle = data.discussionSync === true
  || data.discussionFromDiscourse === true
  || data.discussionbridgeNativePublication === true
  || data.discourseTopicId !== undefined
  || typeof data.discourseTopicUrl === 'string';
---
{!needsDiscussionArticle && <DefaultPageTitle />}

