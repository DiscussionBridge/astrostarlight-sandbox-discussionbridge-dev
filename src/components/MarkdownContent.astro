---
import DefaultMarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
import NativeArticle from './NativeArticle.astro';

const entry = Astro.locals.starlightRoute.entry;
const needsDiscussionArticle = entry.data.discussionSync === true
  || entry.data.discussionFromDiscourse === true
  || entry.data.discussionbridgeNativePublication === true
  || entry.data.discourseTopicId !== undefined
  || typeof entry.data.discourseTopicUrl === 'string';
---
<DefaultMarkdownContent>
  {needsDiscussionArticle ? <NativeArticle entry={entry}><slot /></NativeArticle> : <slot />}
</DefaultMarkdownContent>

